# PamirNet production environment
# Copy to .env.production, chmod 600, and never commit the real file.

PAMIRNET_ENV=production
PAMIRNET_LOG_LEVEL=INFO
PAMIRNET_BUILD_SHA=

# Public application
PAMIRNET_DOMAIN=pamirnet.example.com
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
DJANGO_ALLOWED_HOSTS=pamirnet.example.com
CSRF_TRUSTED_ORIGINS=https://pamirnet.example.com
CORS_ALLOWED_ORIGINS=https://pamirnet.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
PAMIRNET_LOGIN_RATE=20/minute

# PostgreSQL
POSTGRES_DB=pamirnet
POSTGRES_USER=pamirnet
POSTGRES_PASSWORD=replace-with-strong-random-password

# Redis
REDIS_PASSWORD=replace-with-strong-random-password

# PamirNet encryption / internal RADIUS API
# Generate Fernet key:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PAMIRNET_ENCRYPTION_KEY=replace-with-fernet-key
RADIUS_INTERNAL_TOKEN=replace-with-at-least-64-random-characters

# WireGuard / MikroTik
WIREGUARD_CLIENT_SUBNET=10.250.0.0/16
WIREGUARD_SERVER_ADDRESS=10.250.0.1/16
WIREGUARD_SERVER_PUBLIC_KEY=replace-with-server-public-key
WIREGUARD_ENDPOINT=203.0.113.10:51820
WIREGUARD_PORT=51820
WIREGUARD_INTERFACE=wg0

# Bind RADIUS only to the private WireGuard address, never 0.0.0.0.
RADIUS_BIND_IP=10.250.0.1

# Local host reverse-proxy ports
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Workers
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=INFO

# Retention
ACCOUNTING_RAW_RETENTION_DAYS=365
ROUTER_HEALTH_RETENTION_DAYS=30

# Backup destination on the VPS
PAMIRNET_BACKUP_DIR=/var/backups/pamirnet
PAMIRNET_BACKUP_RETENTION_DAYS=14
