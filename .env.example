# Django
DJANGO_SECRET_KEY=change-me-to-at-least-32-random-bytes
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
PAMIRNET_ENCRYPTION_KEY=

# PostgreSQL
POSTGRES_DB=pamirnet
POSTGRES_USER=pamirnet
POSTGRES_PASSWORD=pamirnet
DATABASE_URL=postgresql://pamirnet:pamirnet@db:5432/pamirnet

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# WireGuard / MikroTik
WIREGUARD_CLIENT_SUBNET=10.250.0.0/16
WIREGUARD_SERVER_ADDRESS=10.250.0.1/16
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_ENDPOINT=
WIREGUARD_PORT=51820
WIREGUARD_INTERFACE=wg0

# FreeRADIUS internal API authentication
RADIUS_INTERNAL_TOKEN=change-me-to-a-long-random-token

# Accounting / monitoring retention
ACCOUNTING_RAW_RETENTION_DAYS=365
ROUTER_HEALTH_RETENTION_DAYS=30

# Frontend
VITE_API_BASE_URL=/api
